accessWidener	v2	named

# WDL: the connection packet tee reaches the connection's Netty pipeline through the private,
# non-final Connection.channel. Non-final, so accessible (read) alone suffices; no mutable. The NeoForge
# analog is the access transformer at neoforge/src/main/resources/META-INF/accesstransformer.cfg.
accessible	field	net/minecraft/network/Connection	channel	Lio/netty/channel/Channel;

# WDL: a relative-move packet (the common walk update) carries its entity id in a protected field with no public
# getter, so the tee reads it to feed the move to the accumulator off the Netty thread. Read-only, so accessible.
accessible	field	net/minecraft/network/protocol/game/ClientboundMoveEntityPacket	entityId	I

# WDL: a mount inventory menu names the animal the server opened it for in a non-public field with no getter, so
# the open-container bind reads it rather than inferring the animal from the crosshair or the ridden vehicle.
# Read-only, so accessible alone suffices (final stays final).
accessible	field	net/minecraft/world/inventory/AbstractMountInventoryMenu	mount	Lnet/minecraft/world/entity/LivingEntity;
