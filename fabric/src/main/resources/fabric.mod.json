{
  "schemaVersion": 1,
  "id": "wdl",
  "version": "${version}",
  "name": "Archive World Downloader",
  "icon": "icon.png",
  "description": "Keep the multiplayer worlds you visit. As you explore, the mod saves the terrain, mobs, and maps around you into a singleplayer world you can open offline, and containers save their contents when you open them. Everything comes from your own game, so nothing runs on the server.",
  "authors": [
    "terbin"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/${mod_id}",
    "sources": "https://github.com/thearchive-world/archive-world-downloader",
    "issues": "https://github.com/thearchive-world/archive-world-downloader/issues"
  },
  "license": "LGPL-3.0-or-later",
  "environment": "client",
  "accessWidener": "wdl.accesswidener",
  "entrypoints": {
    "client": [
      "world.thearchive.wdl.fabric.WdlFabricClient"
    ],
    "modmenu": [
      "world.thearchive.wdl.fabric.WdlFabricModMenu"
    ],
    "journeymap": [
      "world.thearchive.wdl.compat.journeymap.v2.WdlJourneyMapPlugin"
    ]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version_min}",
    "fabric": "*",
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_version}"
  }
}
